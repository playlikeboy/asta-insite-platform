# Copy values into the file each app reads. Never commit real values.
#   apps/web/.env.local          server variables
#   apps/mobile/.env.local       EXPO_PUBLIC_* variables (these ship inside the app, so never secrets)
#   packages/database/.env       DIRECT_URL for migrations
# Full reference: docs/operations/ENVIRONMENT_VARIABLES.md

# --- apps/web (server only) ---
# Pooled connection, port 6432
DATABASE_URL=postgresql://USER:PASSWORD@db-HASH.sgp.appwrite.center:6432/DATABASE?sslmode=require

# --- packages/database (migrations only) ---
# Direct connection, port 5432
DIRECT_URL=postgresql://USER:PASSWORD@db-HASH.sgp.appwrite.center:5432/DATABASE?sslmode=require

# --- apps/mobile (public, bundled into the app) ---
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# --- tests (optional) ---
# Destructive: the integration suite drops and recreates this database's public schema.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/asta_test
